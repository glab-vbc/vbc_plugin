    given-names: Ankit
    affiliation: "Goloborodko lab"
license: BSD-3-Clause
repository-code: "https://github.com/glab-vbc/vbc_plugin"   
version: "1.0.0"          
date-released: "2026-07-17"  
keywords:
  - molecular-dynamics
  - HOOMD-blue
  - coarse-grained
  - pair-potential
  - valency
